{
  "name": "leeft-monorepo",
  "private": true,
  "packageManager": "pnpm@10.28.1+sha512.7d7dbbca9e99447b7c3bf7a73286afaaf6be99251eb9498baefa7d406892f67b879adb3a1d7e687fc4ccc1a388c7175fbaae567a26ab44d1067b54fcb0d6a316",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "PORT=${PORT:-$(cat .dev-port 2>/dev/null || echo 3000)} pnpm --filter @leeft/web dev",
    "wt": "./scripts/shell/worktree.sh",
    "build:web": "pnpm --filter @leeft/web build",
    "build:desktop": "pnpm --filter @leeft/web build:desktop",
    "deploy:web": "pnpm build:web && cd apps/web && firebase deploy",
    "pipeline": "./scripts/shell/pipeline.sh",
    "refresh": "pnpm --filter @leeft/data refresh && pnpm push",
    "push": "./scripts/shell/upload.sh",
    "lint": "pnpm -r lint",
    "format": "pnpm -r format",
    "check": "pnpm -r --no-bail check",
    "check:fix": "pnpm -r check:fix",
    "knip": "knip"
  },
  "devDependencies": {
    "@types/node": "^25.3.0",
    "knip": "^5.85.0",
    "typescript": "catalog:"
  }
}
