<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>Leeft</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>

	<!-- Required for the app to lay out full-screen rather than in compatibility letterboxing. -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>

	<!-- Portrait only, matching the web manifest's orientation lock. -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>

	<!-- The v2 palette is dark-only; the web app never had a light variant of /add. -->
	<key>UIUserInterfaceStyle</key>
	<string>Dark</string>

	<!-- Google sign-in redirects back through this scheme. It's the REVERSED_CLIENT_ID from
	     GoogleService-Info.plist — a public client identifier that ships in the binary, not
	     a secret. If you ever re-register the iOS app in Firebase, this has to change too. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.944013057035-6o9k1nj84jnv4ik0b6huf8lrq3hrf25p</string>
			</array>
		</dict>
	</array>

	<!-- Custom faces are optional: Theme falls back to system fonts when a file is absent,
	     so the app builds and runs with an empty Resources/Fonts/ folder. -->
	<key>UIAppFonts</key>
	<array>
		<string>Anton-Regular.ttf</string>
		<string>DMSans-Regular.ttf</string>
		<string>DMSans-Medium.ttf</string>
		<string>DMSans-Bold.ttf</string>
		<string>JetBrainsMono-Regular.ttf</string>
		<string>JetBrainsMono-SemiBold.ttf</string>
	</array>
</dict>
</plist>
