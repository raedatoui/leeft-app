{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Leeft",
    "version": "0.1.0",
    "identifier": "com.leeft.app",
    "build": {
        "frontendDist": "../web/out",
        "devUrl": "http://localhost:3000",
        "beforeDevCommand": "pnpm --filter @leeft/web dev",
        "beforeBuildCommand": "pnpm --filter @leeft/web build"
    },
    "app": {
        "windows": [
            {
                "title": "Leeft",
                "width": 1280,
                "height": 800,
                "minWidth": 390,
                "resizable": true,
                "fullscreen": false
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
    }
}
